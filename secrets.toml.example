# Copier ce contenu dans Streamlit Cloud > App > Settings > Secrets (NE JAMAIS le publier sur GitHub).
# Les clés de premier niveau sont exposées comme variables d'environnement.
TIMAR_ADMIN_EMAIL = "votre-adresse@gmail.com"
TIMAR_ADMIN_PASSWORD = "un-mot-de-passe-solide"

# Envoi du code de vérification par e-mail (obligatoire sur un site publié ; sans cela l'inscription est refusée).
# Gmail : activer la validation en 2 étapes, puis créer un « mot de passe d'application » (16 caractères) :
# https://myaccount.google.com/apppasswords
SMTP_USER = "timar.app@gmail.com"
SMTP_PASSWORD = "abcd efgh ijkl mnop"
# SMTP_HOST = "smtp.gmail.com"
# SMTP_PORT = "465"

# Formule Pro (affichage) : prix affiché sur le site et numéro WhatsApp (chiffres avec indicatif, sans +) pour le bouton « Contacter ».
PRO_PRICE_TEXT = "50 $ / mois"
CONTACT_WHATSAPP = "212600000000"
# Texte du bouton de contact (facultatif)
# CONTACT_LABEL = "Pour info, contacter TIMAR"

# Mode maintenance (facultatif) : "1" = site fermé aux clients (l'Admin garde l'accès). Plus sûr que le réglage dans l'application
# car il survit aux redémarrages de Streamlit Cloud.
# MAINTENANCE_MODE = "1"
